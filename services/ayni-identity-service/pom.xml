<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.ayni.bank</groupId>
        <artifactId>ayni-bank</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ayni-identity-service</artifactId>
    <name>ayni-identity-service</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Validacion declarativa de los DTO de entrada (@Email, @Pattern,
             @AssertTrue). Es una dependencia aparte desde Spring Boot 3: no
             viene dentro de starter-web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JPA. Sustituye a starter-jdbc, que solo servia para que Flyway
             tuviera un DataSource cuando no habia entidades. El starter incluye
             JDBC, de modo que Flyway sigue funcionando igual.

             `ddl-auto` NO se activa: el esquema lo define Flyway y solo Flyway.
             Ver §4.5 del documento de diseño. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Solo `spring-security-crypto`, no `spring-boot-starter-security`.
             Aqui hace falta unicamente Argon2PasswordEncoder para HU-01;
             traerse el starter activaria la cadena de filtros completa, que
             cerraria los endpoints de actuator y rompería los health checks del
             compose antes de que exista una sola regla de autorizacion. La
             seguridad web entra con HU-04, que es donde se configura. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Argon2PasswordEncoder delega en Bouncy Castle: sin esta
             dependencia el bean se construye y falla en la primera llamada
             con NoClassDefFoundError, no al arrancar. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <!-- Firma y verificacion del token de acceso. Se trae Nimbus a secas y no
             `spring-boot-starter-oauth2-resource-server`, que arrastraria la cadena
             de filtros de Spring Security entera por el mismo motivo explicado
             arriba. La version la gestiona el BOM de Spring Boot. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
        </dependency>
        <!-- Publica el evento que abre la cuenta en core-banking. Es la pieza que
             convierte cinco servicios sueltos en un esqueleto ambulante. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Desde Flyway 10 el soporte de cada motor va en su propio modulo -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pruebas de aceptacion en Gherkin. Los escenarios que el docente
             aprobo en la HU se ejecutan tal cual estan escritos, en castellano;
             si alguien cambia el comportamiento sin actualizar la historia, la
             prueba falla y la discrepancia sale a la luz en el build. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Sin este artefacto, JUnit 5 descubre los motores pero no expone la
             anotacion @Suite con la que se seleccionan las carpetas de features. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
