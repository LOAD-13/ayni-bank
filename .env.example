# ══════════════════════════════════════════════════════════════════════════
#  Ayni Bank — plantilla de variables de entorno
#
#  Copiar a .env y sustituir los valores:   cp .env.example .env
#
#  ⚠  El archivo .env NUNCA se versiona. Está excluido en .gitignore y
#     Gitleaks bloquea el pipeline si detecta un secreto en el repositorio.
#     Los valores de abajo son de EJEMPLO y solo válidos en desarrollo local.
# ══════════════════════════════════════════════════════════════════════════

# ─── Perfil de ejecución ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=ayni
POSTGRES_USER=ayni_app
POSTGRES_PASSWORD=cambiar_en_local

# ─── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_USER=ayni
RABBITMQ_PASSWORD=cambiar_en_local

# ─── MinIO (almacenamiento S3) ─────────────────────────────────────────────
MINIO_ROOT_USER=ayni_minio
MINIO_ROOT_PASSWORD=cambiar_en_local

# ─── Seguridad ─────────────────────────────────────────────────────────────
# Generar con:  openssl rand -base64 48
AYNI_JWT_SECRET=generar_con_openssl_rand_base64_48

# Clave AES-256 para cifrado en reposo del PAN, documento y semilla TOTP.
# Generar con:  openssl rand -base64 32
AYNI_ENCRYPTION_KEY=generar_con_openssl_rand_base64_32

# ─── Servicio de verificación de identidad ────────────────────────────────
# Umbral mínimo de similitud facial para aprobar automáticamente (0.0 – 1.0).
# Por debajo se deriva a revisión manual del Oficial de Cumplimiento.
AYNI_UMBRAL_SIMILITUD_FACIAL=0.80

# ─── Tipo de cambio (integración externa real) ────────────────────────────
AYNI_FX_SUNAT_URL=https://api.apis.net.pe/v2/sunat/tipo-cambio
AYNI_FX_TIMEOUT_MS=5000

# ─── Correo transaccional ──────────────────────────────────────────────────
AYNI_SMTP_HOST=smtp-relay.brevo.com
AYNI_SMTP_PORT=587
AYNI_SMTP_USER=cambiar_en_local
AYNI_SMTP_PASSWORD=cambiar_en_local
AYNI_SMTP_REMITENTE=no-responder@ayni.pe

# ─── Observabilidad ────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=cambiar_en_local
