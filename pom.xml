<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>pe.ayni.bank</groupId>
    <artifactId>ayni-bank</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Ayni Bank</name>
    <description>Plataforma de banca 100% digital</description>

    <modules>
        <module>services/ayni-gateway</module>
        <module>services/ayni-identity-service</module>
        <module>services/ayni-core-banking-service</module>
        <module>services/ayni-notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot 3.5.16 gestiona Netty 4.1.135, que aun arrastra cinco
             vulnerabilidades ALTAS en netty-codec y netty-codec-http (entre ellas
             CVE-2026-56745 y CVE-2026-56819). Se eleva al primer parche que las
             corrige. Al subir Spring Boot, comprobar si esta linea ya sobra. -->
        <netty.version>4.1.136.Final</netty.version>
        <!-- El driver 42.7.11 que gestiona Spring Boot 3.5.16 arrastra
             CVE-2026-54291 (ALTA), corregida en 42.7.12. Al subir Spring Boot,
             comprobar si esta linea ya sobra. -->
        <postgresql.version>42.7.13</postgresql.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- Spring Boot no gestiona Bouncy Castle: no forma parte de su BOM.
             Lo necesita Argon2PasswordEncoder, que delega en el toda la
             derivacion de la contraseña. Se fija aqui, en el padre, para que
             los cuatro servicios usen la misma version y no aparezcan dos en
             el mismo classpath. -->
        <bouncycastle.version>1.85.2</bouncycastle.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar.version>5.0.0.4389</sonar.version>
        <!-- Excluidas del calculo de cobertura: clases de arranque de Spring Boot,
             configuracion y puertos del dominio. Son declaraciones sin logica, y
             medir su cobertura no dice nada sobre la calidad de las pruebas.
             El umbral del 80 % se aplica al dominio, que es donde vive el negocio. -->
        <sonar.coverage.exclusions>
            **/*Application.java,
            **/infrastructure/config/**,
            **/domain/port/**
        </sonar.coverage.exclusions>
        <!-- Umbral de cobertura del dominio exigido por la Definition of Done -->
        <jacoco.dominio.minimo>0.80</jacoco.dominio.minimo>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Sin este registro, exponer `prometheus` en management.endpoints no
             crea el endpoint: /actuator/prometheus devuelve 404 y Prometheus
             marca el objetivo como caido. El actuator declara el contrato; este
             modulo es el que lo implementa. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Declarado para que el prefijo `sonar:sonar` resuelva: no pertenece
                 a los plugin groups por defecto de Maven. -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.version}</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- Sin esta ejecucion, jacoco.dominio.minimo es un numero
                         que no lee nadie: `report` mide pero no exige, y solo
                         `check` rompe el build.

                         Se activa ya, aunque los paquetes de dominio esten
                         vacios, porque hoy es inerte: la regla no encuentra
                         paquetes que evaluar y el build pasa. En cuanto exista
                         la primera clase de dominio empieza a exigir el 80 %
                         sola, sin que nadie tenga que acordarse de activarla.

                         El umbral se aplica al dominio y solo al dominio: es
                         donde vive el negocio. Ver ADR-0006. -->
                    <execution>
                        <id>umbral-dominio</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pe.ayni.bank.*.domain.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.dominio.minimo}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
