<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>pe.ayni.bank</groupId>
    <artifactId>ayni-bank</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Ayni Bank</name>
    <description>Plataforma de banca 100% digital</description>

    <modules>
        <module>services/ayni-gateway</module>
        <module>services/ayni-identity-service</module>
        <module>services/ayni-core-banking-service</module>
        <module>services/ayni-notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot 4.0.9 gestiona amqp-client 5.27.1 (Spring Boot 3.5.16 gestionaba 5.25.0), que arrastra tres
             vulnerabilidades ALTAS (CVE-2026-63337, CVE-2026-69219 y CVE-2026-69220),
             corregidas en 5.33.1. Esa version arrastra a su vez CVE-2026-75516 (ALTA,
             denegacion de servicio por tramas de tamaño excesivo), corregida en 5.34.0.
             Se fija a 5.36.0, la ultima disponible. Entro en el arbol al anadir AMQP
             para el esqueleto ambulante. Al subir Spring Boot, comprobar si esta linea
             ya sobra. -->
        <rabbit-amqp-client.version>5.36.0</rabbit-amqp-client.version>
        <archunit.version>1.4.2</archunit.version>
        <!-- Spring Boot no gestiona Bouncy Castle: no forma parte de su BOM.
             Lo necesita Argon2PasswordEncoder, que delega en el toda la
             derivacion de la contraseña. Se fija aqui, en el padre, para que
             los cuatro servicios usen la misma version y no aparezcan dos en
             el mismo classpath. -->
        <bouncycastle.version>1.85.2</bouncycastle.version>
        <!-- Spring Boot tampoco gestiona Nimbus: su version la fija el BOM de Spring
             Security, que aqui no se importa porque no se usa el starter completo.
             Firma el token de acceso de HU-04. -->
        <nimbus.version>10.3</nimbus.version>
        <!-- Cucumber tampoco esta en el BOM de Spring Boot. Se importa su propio
             BOM mas abajo para que las cuatro dependencias que hacen falta
             (java, spring, junit-platform-engine y el conector de JUnit) vayan
             siempre a la misma version: mezclarlas rompe el descubrimiento de
             escenarios con un error que no menciona la causa. -->
        <cucumber.version>7.34.9</cucumber.version>
        <jacoco.version>0.8.14</jacoco.version>
        <sonar.version>5.0.0.4389</sonar.version>
        <!-- Excluidas del calculo de cobertura: clases de arranque de Spring Boot,
             configuracion y puertos del dominio. Son declaraciones sin logica, y
             medir su cobertura no dice nada sobre la calidad de las pruebas.
             El umbral del 80 % se aplica al dominio, que es donde vive el negocio. -->
        <sonar.coverage.exclusions>
            **/*Application.java,
            **/infrastructure/config/**,
            **/domain/port/**,
            **/infrastructure/out/persistence/*Entity.java,
            **/infrastructure/in/web/*Dto.java,
            **/infrastructure/out/client/*/api/**,
            **/infrastructure/out/client/*/invoker/**,
            **/infrastructure/out/client/*/model/**
        </sonar.coverage.exclusions>
        <!-- La revision de Envers (HU-15) es la misma clase en core-banking y en identity: los
             servicios no comparten codigo, cada uno es su propio contexto acotado, y una libreria
             comun solo para esta entidad ataria sus despliegues. Se excluye solo ella del calculo
             de duplicados; sus pruebas siguen contando para la cobertura. -->
        <sonar.cpd.exclusions>
            **/infrastructure/out/persistence/RevisionDeAuditoria.java
        </sonar.cpd.exclusions>
        <!-- Umbral de cobertura del dominio exigido por la Definition of Done -->
        <jacoco.dominio.minimo>0.80</jacoco.dominio.minimo>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Documentación OpenAPI viva (Swagger UI). Apagada por defecto en todos los
                 servicios: solo el compose local la enciende con AYNI_API_DOCS. Ver ADR-0033. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>3.0.3</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>3.0.3</version>
            </dependency>
            <!-- SDK de AWS v2: correo transaccional con Amazon SES (identity). -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.55.10</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Sin este registro, exponer `prometheus` en management.endpoints no
             crea el endpoint: /actuator/prometheus devuelve 404 y Prometheus
             marca el objetivo como caido. El actuator declara el contrato; este
             modulo es el que lo implementa. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Id de peticion en cada linea de log (traceId de Micrometer Tracing con Brave).
             El gateway lo propaga en la cabecera traceparent, asi que una misma operacion
             se sigue en los logs de todos los servicios. No se exporta a ningun colector. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Declarado para que el prefijo `sonar:sonar` resuelva: no pertenece
                 a los plugin groups por defecto de Maven. -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Los cuatro primeros patrones son los que Surefire trae por
                         defecto; hay que repetirlos porque `includes` los sustituye
                         en lugar de ampliarlos. El quinto es el que importa: las
                         suites de aceptacion no llevan «Test» en el nombre, y sin
                         esta linea Cucumber no se ejecuta y el build pasa en verde
                         sin haber comprobado ni un escenario de las historias. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/PruebasDeAceptacion.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <!-- Lo mismo que excluye SonarCloud, y ademas el cliente HTTP que
                     openapi-generator genera desde contracts/: es codigo que no
                     escribimos ni probamos nosotros, y contarlo hundia el porcentaje
                     de identity sin decir nada de la calidad de sus pruebas. -->
                <configuration>
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                        <exclude>**/infrastructure/config/**</exclude>
                        <exclude>**/domain/port/**</exclude>
                        <exclude>**/infrastructure/out/persistence/*Entity.class</exclude>
                        <exclude>**/infrastructure/in/web/*Dto.class</exclude>
                        <exclude>**/infrastructure/out/client/*/api/**</exclude>
                        <exclude>**/infrastructure/out/client/*/invoker/**</exclude>
                        <exclude>**/infrastructure/out/client/*/model/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- Sin esta ejecucion, jacoco.dominio.minimo es un numero
                         que no lee nadie: `report` mide pero no exige, y solo
                         `check` rompe el build.

                         Se activa ya, aunque los paquetes de dominio esten
                         vacios, porque hoy es inerte: la regla no encuentra
                         paquetes que evaluar y el build pasa. En cuanto exista
                         la primera clase de dominio empieza a exigir el 80 %
                         sola, sin que nadie tenga que acordarse de activarla.

                         El umbral se aplica al dominio y solo al dominio: es
                         donde vive el negocio. Ver ADR-0006. -->
                    <execution>
                        <id>umbral-dominio</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pe.ayni.bank.*.domain.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.dominio.minimo}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Pruebas de mutacion con PIT (AYNI-304). Fuera del build normal: tardan, y lo que miden
             es la calidad de las pruebas del dominio, no si el codigo compila o pasa.

             mvn -Pmutacion -pl services/ayni-core-banking-service -am test-compile                  org.pitest:pitest-maven:mutationCoverage -Djacoco.skip=true

             El informe queda en target/pit-reports/index.html. La interpretacion y los mutantes
             que se aceptan estan en docs/calidad/pruebas-de-mutacion.md. -->
        <profile>
            <id>mutacion</id>
            <properties>
                <pitest.version>1.30.2</pitest.version>
                <pitest.junit5.version>1.2.3</pitest.junit5.version>
                <!-- Alcance inicial: el dominio del core, donde esta el dinero. Se amplia aqui. -->
                <pit.clases>pe.ayni.bank.core.domain.*</pit.clases>
                <pit.pruebas>pe.ayni.bank.core.domain.*</pit.pruebas>
                <pit.umbral>0</pit.umbral>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>${pit.clases}</param>
                            </targetClasses>
                            <targetTests>
                                <param>${pit.pruebas}</param>
                            </targetTests>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <threads>4</threads>
                            <mutationThreshold>${pit.umbral}</mutationThreshold>
                            <failWhenNoMutations>false</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
